<style>
  .clients-feedback {
    padding: 60px 0;
  }
  .clients-feedback p {
    margin: 0;
  }
  .clients-feedback img {
    max-width: 100%;
    height: auto;
  }
  .cf-content {
    margin: 0 auto;
  }
  p.cf-title {
    font-size: 44px;
    line-height: 60px;
    font-weight: 800;
    margin-bottom: 50px;
  }
  .cf-item {
    width: 100%;
    margin: 20px 0;
    padding: 65px 60px 65px 100px;
    background-color: #fff;
    border-radius: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    gap: 15px;
  }
  .cf-item:hover {
    box-shadow: 0 12px 20px 6px rgba(96, 109, 128, 0.04), 0 8px 16px 4px rgba(96, 109, 128, 0.04),
      0 4px 14px 0 rgba(98, 111, 131, 0.04);
  }
  p.cf-text-desc {
    max-width: 800px;
    font-size: 20px;
    line-height: 32px;
    font-weight: 500;
  }
  .cf-rings {
    display: flex;
  }
  .cf-rings img {
    max-height: 28px;
    width: auto;
  }
  @media screen and (max-width: 750px) {
    .clients-feedback {
      padding: 30px 0;
    }
    p.cf-title {
      font-size: 24px;
      line-height: 36px;
      margin-bottom: 30px;
    }
    .cf-item {
      flex-direction: column;
      justify-content: center;
      padding: 20px 10px;
    }
    p.cf-text-desc {
      font-size: 14px;
      line-height: 24px;
      text-align: center;
      margin-bottom: 10px;
    }
  }
</style>
<div class="clients-feedback">
  <div class="cf-content wrapper">
    <p class="cf-title">Feedback from Our Clients</p>
    <div class="cf-item-box">
      <div class="cf-item">
        <p class="cf-text-desc">
          "QY Crafts is more than a supplier. Their team brings actionable data insights, clear proposals, and timely
          execution to every project. We can always count on them to deliver with precision and professionalism."
        </p>
        <div class="cf-rings">
          <img src="https://cdn.shopify.com/s/files/1/0710/6176/6321/files/Star.png?v=1750352297" alt="">
        </div>
      </div>
      <div class="cf-item">
        <p class="cf-text-desc">
          "Their creative team has a sharp eye for detail and a deep understanding of consumer preferences, making them
          an exceptional design partner."
        </p>
        <div class="cf-rings">
          <img src="https://cdn.shopify.com/s/files/1/0710/6176/6321/files/Star.png?v=1750352297" alt="">
        </div>
      </div>
      <div class="cf-item">
        <p class="cf-text-desc">
          "From product quality to category integration, QY Crafts checks all the boxes. Their ability to streamline
          assortments, maintain consistency, and offer strong overall service has made them a reliable partner for our
          craft programs."
        </p>
        <div class="cf-rings">
          <img src="https://cdn.shopify.com/s/files/1/0710/6176/6321/files/Star.png?v=1750352297" alt="">
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Clients Feedback",
  "settings": [],
  "presets": [
    {
      "name": "Clients Feedback"
    }
  ]
}
{% endschema %}
