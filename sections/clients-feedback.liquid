<style>
  .clients-feedback {
    padding: 60px 0;
  }
  .clients-feedback p {
    margin: 0;
  }
  .clients-feedback img {
    max-width: 100%;
    height: auto;
  }
  .cf-content {
    max-width: 1440px;
    margin: 0 auto;
  }
  p.cf-title {
    font-size: 44px;
    line-height: 60px;
    font-weight: 800;
    margin-bottom: 50px;
  }
  .cf-item {
    width: 100%;
    margin: 20px 0;
    padding: 40px 10px;
    background-color: #fff;
    border-radius: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
  }
  .cf-item:hover {
    box-shadow: 0 12px 20px 6px rgba(96, 109, 128, 0.04), 0 8px 16px 4px rgba(96, 109, 128, 0.04),
      0 4px 14px 0 rgba(98, 111, 131, 0.04);
  }
  .cf-img {
    max-width: 280px;
    padding: 50px 40px;
  }
  .cf-text {
    margin: 0 10px;
    max-width: 800px;
  }
  p.cf-text-desc {
    font-size: 20px;
    line-height: 32px;
    font-weight: 500;
    margin-bottom: 15px;
  }
  p.cf-text-author {
    font-size: 20px;
    line-height: 32px;
    font-weight: 500;
    color: #727981;
  }
  .cf-rings {
    padding: 25px 60px;
    border-left: 2px solid #eaf2f4;
  }
  .cf-rings img {
    max-height: 30px;
    width: auto;
  }
  @media screen and (max-width: 750px) {
  }
</style>
<div class="clients-feedback">
  <div class="cf-content">
    <p class="cf-title">Feedback from Our Clients</p>
    <div class="cf-item-box">
      <div class="cf-item">
        <div class="cf-img">
          <img src="https://cdn.shopify.com/s/files/1/0710/6176/6321/files/logo_1.png?v=1750352297" alt="">
        </div>
        <div class="cf-text">
          <p class="cf-text-desc">
            "QY Crafts is more than a supplier. Their team brings actionable data insights, clear proposals, and timely
            execution to every project. We can always count on them to deliver with precision and professionalism."
          </p>
          <p class="cf-text-author">Senior Buyer, Costco</p>
        </div>
        <div class="cf-rings">
          <img src="https://cdn.shopify.com/s/files/1/0710/6176/6321/files/Star.png?v=1750352297" alt="">
        </div>
      </div>
      <div class="cf-item">
        <div class="cf-img">
          <img src="https://cdn.shopify.com/s/files/1/0710/6176/6321/files/logo_2.png?v=1750352297" alt="">
        </div>
        <div class="cf-text">
          <p class="cf-text-desc">
            "QY Crafts is more than a supplier. Their team brings actionable data insights, clear proposals, and timely
            execution to every project. We can always count on them to deliver with precision and professionalism."
          </p>
          <p class="cf-text-author">Craft Buyer, Michaels</p>
        </div>
        <div class="cf-rings">
          <img src="https://cdn.shopify.com/s/files/1/0710/6176/6321/files/Star.png?v=1750352297" alt="">
        </div>
      </div>
      <div class="cf-item">
        <div class="cf-img">
          <img src="https://cdn.shopify.com/s/files/1/0710/6176/6321/files/logo_3.png?v=1750352297" alt="">
        </div>
        <div class="cf-text">
          <p class="cf-text-desc">
            "QY Crafts is more than a supplier. Their team brings actionable data insights, clear proposals, and timely
            execution to every project. We can always count on them to deliver with precision and professionalism."
          </p>
          <p class="cf-text-author">Sourcing Manager, Dollar General</p>
        </div>
        <div class="cf-rings">
          <img src="https://cdn.shopify.com/s/files/1/0710/6176/6321/files/Star.png?v=1750352297" alt="">
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Clients Feedback",
  "settings": [],
  "presets": [
    {
      "name": "Clients Feedback"
    }
  ]
}
{% endschema %}
