<style>
  .footer-contact-form {
    padding: 0;
  }
  .footer-contact-form p {
    margin: 0;
  }
  .fcf-form-text {
    text-align: center;
    max-width: 936px;
    margin: 0 auto;
  }
  p.fcf-title {
    font-size: 40px;
    line-height: 56px;
    font-weight: 800;
  }
  p.fcf-desc {
    margin-top: 30px;
    font-size: 24px;
    line-height: 36px;
    font-weight: 500;
  }
  .fcf-form-box {
    margin-top: 80px;
  }
  .fcf-form {
    max-width: 1070px;
    position: relative;
    margin: 0 auto;
    margin-bottom: -25%;
  }
  .fcf-form-content {
    position: absolute;
    top: 0;
    left: 0;
    width: 544px;
    margin: 40px;
  }
  .fcf-form-bg {
    width: 100%;
  }

  .form-item {
    position: relative;
  }
  .form-item label {
    position: absolute !important;
    overflow: hidden;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    clip: rect(0 0 0 0);
    word-wrap: normal !important;
  }
  .fcf-form-form .form-item input,
  .fcf-form-form textarea {
    width: 100%;
    background-color: #fff;
    border: none;
    outline: none;
    border-radius: 10px;
    margin-bottom: 24px;
    font-size: 14px;
    padding: 16px;
  }
  .fcf-form-form .submit {
    display: flex;
    justify-content: center;
  }
  .fcf-form-form .submit input {
    background-color: #70c6ef;
    color: #fff;
    border: none;
    outline: none;
    border-radius: 10px;
    font-size: 20px;
    font-weight: 800;
    padding: 16px 40px;
  }
  .fcf-form-form .form-success {
    color: #fff;
    font-size: 20px;
    line-height: 34px;
    text-align: center;
  }
  .fcf-form-form .form-fail {
    max-width: 545px;
    word-wrap: break-word;
    color: #f8cc56;
    font-size: 20px;
    line-height: 34px;
    text-align: center;
  }
  .fcf-bg {
    display: flex;
  }
  .fcf-bg img {
    max-width: 100%;
    height: auto;
  }
</style>
<div class="footer-contact-form">
  <div class="fcf-content">
    <div class="fcf-form-text">
      <p class="fcf-title">Get a Sample Now!</p>
      <p class="fcf-desc">
        More than 1,200 global partners trust QY Crafts for dependable sampling and speed. Let’s collaborate on your
        next product.
      </p>
    </div>
    <div class="fcf-form-box">
      <div class="fcf-form">
        <div class="fcf-form-content">
          <div class="fcf-form-form">
            {% form 'contact' %}
              {%- if form.posted_successfully? -%}
                <h2 class="form-success form-status form-status-list form__message" tabindex="-1" autofocus>
                  Submit Successfully
                </h2>
              {%- elsif form.errors -%}
                <div class="form__message">
                  <h2 class="form-fail form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
                    Submission failed, please check the information you filled in
                  </h2>
                </div>
                <ul class="form-status-list caption-large" role="list">
                  <li>
                    <a href="#ContactForm-email" class="link">
                      {{ form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email }}
                    </a>
                  </li>
                </ul>
              {%- endif -%}

              <div class="first-name form-item">
                <label for="first-name">First name</label>
                <input type="text" name="contact[first_name]" id="first-name" placeholder="Name" required>
              </div>

              <div class="country form-item">
                <label for="country">Country</label>
                <input type="text" name="contact[country]" id="country" placeholder="Country" required>
              </div>

              <div class="email form-item">
                <label for="email">Email</label>
                <input type="email" name="contact[email]" id="email" placeholder="Email">
              </div>

              <div class="contact-number form-item">
                <label for="contact-number">Contact Number</label>
                <input type="text" name="contact[contact_number]" id="contact-number" placeholder="Contact Number">
              </div>

              <div class="whatsapp form-item">
                <label for="whatsapp">WhatsApp</label>
                <input type="text" name="contact[whatsapp]" id="whatsapp" placeholder="Whatsapp">
              </div>

              <div class="message form-item">
                <label for="message">Message</label>
                <textarea name="contact[body]" id="message" placeholder="Your message"></textarea>
              </div>

              <div class="submit">
                <input type="submit" value="Submit">
              </div>
            {% endform %}
          </div>
        </div>
        <div class="fcf-form-bg">
          <img src="https://cdn.shopify.com/s/files/1/0710/6176/6321/files/card_bg.png" alt="">
        </div>
      </div>
      <div class="fcf-bg">
        <img src="https://cdn.shopify.com/s/files/1/0710/6176/6321/files/bot_bg.png" alt="">
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Footer Contact Form",
  "settings": [],
  "presets": [
    {
      "name": "Footer Contact Form"
    }
  ]
}
{% endschema %}
