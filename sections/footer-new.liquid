<style>
  .site-footer-new {
    background-color: #fff;
    padding: 70px 0 120px;
  }
  .site-footer-new p,
  .site-footer-new li {
    margin: 0;
  }
  .site-footer-new ul {
    margin: 0;
  }
  .site-footer-new li {
    list-style: none;
  }
  .site-footer-new-box {
    display: grid;
    grid-template-columns: 65% 35%;
  }
  .site-footer-new-box-l {
    display: flex;
    align-items: flex-start;
    justify-content: space-around;
    border-right: 2px solid #f0f0f0;
  }
  .site-footer-new-box-r {
    margin-left: 70px;
  }
  .logo-with-social {
    max-width: 214px;
  }
  .footer-logo {
    max-width: 214px;
    display: flex;
  }
  .footer-logo img {
    max-width: 100%;
    height: auto;
  }
  .footer-social {
    margin-top: 40px;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 20px;
  }
  .footer-social ul.socials li {
    margin-right: 20px;
  }
  .footer-social ul.socials li a {
    display: flex;
    justify-content: center;
  }
  .r-link-menu-item {
    display: flex;
    justify-content: flex-start;
    align-items: center;
  }
  .r-link-menu-item img {
    width: 18px;
  }
  .link-menu-item-box,
  .r-link-menu-box {
    margin-top: 20px;
  }
  .link-menu-title,
  .r-link-title {
    font-size: 20px;
    line-height: 24px;
    font-weight: 800;
    cursor: pointer;
  }
  .link-menu-item-box li a,
  .r-link-menu-item {
    cursor: pointer;
    font-size: 16px;
    line-height: 24px;
    font-weight: 500;
    margin: 10px 0;
    border-bottom: 1px solid transparent;
  }
  .link-menu-item-box li a {
    display: flex;
  }
  .link-menu-item-box li a:hover {
    color: #4fc8f4;
    text-decoration: underline;
    /* border-bottom: 1px solid #4fc8f4; */
  }
  p.r-link-item-text {
    margin-left: 10px;
  }
  .site-footer-Copyright {
    margin-top: 50px;
  }
  .site-footer-Copyright p {
    font-size: 16px;
    line-height: 24px;
    font-weight: 500;
    color: #727981;
    text-align: center;
  }
  @media screen and (max-width: 750px) {
    .site-footer-new {
      padding: 50px 0;
    }
    .site-footer-new-box {
      grid-template-columns: 1fr;
    }
    .site-footer-new-box-l {
      flex-direction: column;
      border-right: none;
    }
    .site-footer-new-box-r {
      margin-left: 0;
      margin-top: 20px;
    }
    .logo-with-social {
      max-width: none;
      width: 100%;
      padding-bottom: 20px;
      border-bottom: 2px solid #f0f0f0;
    }
    .footer-link-menu {
      width: 100%;
      margin-top: 20px;
      padding-bottom: 20px;
      border-bottom: 2px solid #f0f0f0;
    }
    .footer-social {
      margin-top: 20px;
    }
    .site-footer-Copyright {
      margin-top: 20px;
    }
  }
</style>
<div class="site-footer-new">
  <div class="wrapper">
    <div class="site-footer-new-box">
      <div class="site-footer-new-box-l">
        <div class="logo-with-social">
          <div class="footer-logo">
            <a href="/"><img src="{{ section.settings.footer_logo | image_url: width: master }}" alt=""></a>
          </div>
          <div class="footer-social">
            {%- render 'social-icons' -%}
          </div>
        </div>
        <div class="footer-link-menu">
          <div class="link-menu-title">{{ section.settings.footer_menu1.title }}</div>
          <div class="link-menu-item-box">
            <ul>
              {% for item in section.settings.footer_menu1.links %}
                <li>
                  <a href="{{ item.url }}">{{ item.title }}</a>
                </li>
              {% endfor %}
            </ul>
          </div>
        </div>
        <div class="footer-link-menu">
          <div class="link-menu-title">{{ section.settings.footer_menu2.title }}</div>
          <div class="link-menu-item-box">
            <ul>
              {% for item in section.settings.footer_menu2.links %}
                <li>
                  <a href="{{ item.url }}">{{ item.title }}</a>
                </li>
              {% endfor %}
            </ul>
          </div>
        </div>
        <div class="footer-link-menu">
          <div class="link-menu-title">{{ section.settings.footer_menu3.title }}</div>
          <div class="link-menu-item-box">
            <ul>
              {% for item in section.settings.footer_menu3.links %}
                <li>
                  <a href="{{ item.url }}">{{ item.title }}</a>
                </li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
      <div class="site-footer-new-box-r">
        <div class="r-link-title">Contact Us</div>
        <div class="r-link-menu-box">
          <div class="r-link-menu-item">
            <img src="https://cdn.shopify.com/s/files/1/0710/6176/6321/files/bot_ic_whats.png?v=1750489424" alt="">
            <p class="r-link-item-text">WhatsApp: <span>+86 18395858909</span></p>
          </div>
          <div class="r-link-menu-item">
            <img src="https://cdn.shopify.com/s/files/1/0710/6176/6321/files/bot_ic_email.png?v=1750489424" alt="">
            <p class="r-link-item-text">Email: marketing@nbparamont.com</p>
          </div>
          <div class="r-link-menu-item">
            <img src="https://cdn.shopify.com/s/files/1/0710/6176/6321/files/bot_ic_add.png?v=1750489424" alt="">
            <p class="r-link-item-text">Address: No.78, Nanhai Road, Xinqi, Beilun District, Ningbo, China</p>
          </div>
        </div>
      </div>
    </div>
    <div class="site-footer-Copyright">
      <p>{{ section.settings.footer_copyright }}</p>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('.click-to-form').forEach((button) => {
    button.addEventListener('click', (e) => {
      // 阻止默认行为
      e.preventDefault();

      // 获取目标表单元素
      const form = document.querySelector('.fcf-form');

      // 平滑滚动到表单
      form.scrollIntoView({
        behavior: 'smooth',
        block: 'end',
      });
    });
  });
</script>

{% schema %}
{
  "name": "New Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "logo选择"
    },
    {
      "type": "link_list",
      "id": "footer_menu1",
      "label": "Footer Menu1"
    },
    {
      "type": "link_list",
      "id": "footer_menu2",
      "label": "Footer Menu2"
    },
    {
      "type": "link_list",
      "id": "footer_menu3",
      "label": "Footer Menu3"
    },
    {
      "type": "text",
      "id": "footer_copyright",
      "label": "Copyright"
    }
  ],
  "presets": [
    {
      "name": "New Footer"
    }
  ]
}
{% endschema %}
