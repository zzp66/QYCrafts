<style>
  .num-video {
    padding: 60px 0;
  }
  .num-video p {
    margin: 0;
  }
  .nv-content {
    max-width: 1440px;
    margin: 0 auto;
  }
  .nv-box {
    display: flex;
    justify-content: space-between;
  }
  .nv-left-box {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .nv-item {
    background-color: #fff;
    padding: 35px 30px;
    width: 240px;
    border-radius: 16px;
  }
  .nv-item .p1 {
    color: #000;
    font-weight: 800;
    font-size: 40px;
    line-height: 54px;
    margin-bottom: 10px;
  }
  .nv-item .p2 {
    color: #2f2d80;
    font-weight: 500;
    font-size: 18px;
    line-height: 30px;
  }
  .nv-item p span{
    font-size: 28px;
  }
  .nv-item p span sup{
    font-size: 16px;
    vertical-align: super;
  }
  .nv-item.item-hide {
    visibility: hidden;
  }
  .nv-right {
    max-width: 850px;
  }
  .nv-video-box {
    width: 850px;
    height: 508px;
    background-color: #fff;
    border-radius: 16px;
    margin-bottom: 50px;
  }
  .nv-text-box p {
    font-size: 20px;
    line-height: 36px;
    font-weight: 500;
    margin-bottom: 20px;
  }
  .nv-text-box span {
    color: #ef5b80;
  }
  .nv-text-box strong {
    font-weight: 800;
  }
  @media screen and (max-width: 750px) {
  }
</style>
<div class="num-video">
  <div class="nv-content">
    <div class="nv-box">
      <div class="nv-left">
        <div class="nv-left-box">
          <div class="nv-item">
            <p class="p1">12+</p>
            <p class="p2">Years</p>
          </div>
          <div class="nv-item item-hide">
            <p class="p1">12+</p>
            <p class="p2">Years</p>
          </div>
          <div class="nv-item">
            <p class="p1">100+</p>
            <p class="p2">Machines</p>
          </div>
          <div class="nv-item">
            <p class="p1">1,200+</p>
            <p class="p2">Global Suppliers</p>
          </div>
          <div class="nv-item">
            <p class="p1">153M+</p>
            <p class="p2">Sets Manufactured Annually</p>
          </div>
          <div class="nv-item">
            <p class="p1">
              86,500 <span>ft<sup>2</sup></span>
            </p>
            <p class="p2">Factory</p>
          </div>
          <div class="nv-item item-hide">
            <p class="p1">12+</p>
            <p class="p2">Years</p>
          </div>
          <div class="nv-item">
            <p class="p1">100%</p>
            <p class="p2">Compliance with US/EU Standards</p>
          </div>
        </div>
      </div>
      <div class="nv-right">
        <div class="nv-video-box"></div>
        <div class="nv-text-box">
          <p class="nv-text">
            QY Crafts is a <span>leading manufacturer of premium craft materials and creative play components</span>,
            specializing in pom poms, chenille stems, and DIY craft essentials. We transform raw creativity into
            tangible products that inspire makers worldwide.
          </p>
          <p class="nv-text">
            As the manufacturing arm of <span><strong>PARAMONT</strong> Group</span>, we combine global design
            intelligence with industrial excellence. Our Ningbo and U.S. design teams deliver trend-forward concepts,
            while QY Crafts—with 100+ production lines—ensures precision at scale, maintaining a 0.1% defect rate for
            unmatched quality.
          </p>
          <p class="nv-text">
            We are the <span>Builders of Play</span>: From custom components to complete product lines, we empower
            brands to innovate faster. Leveraging PARAMONT’s 1,200+ supplier network and 50,000+ retail doors, we bridge
            imagination and execution—turning creative visions into market-ready realities with unmatched speed and
            quality.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Num Video",
  "settings": [],
  "presets": [
    {
      "name": "Num Video"
    }
  ]
}
{% endschema %}
