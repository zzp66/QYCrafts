<style>
  .trust-quality {
    padding: 60px 0;
  }
  .trust-quality p {
    margin: 0;
  }
  .trust-quality img {
    max-width: 100%;
    height: auto;
  }
  .tq-content {
    max-width: 1440px;
    margin: 0 auto;
  }
  p.tq-title {
    font-size: 50px;
    line-height: 60px;
    font-weight: 800;
    margin-bottom: 60px;
  }
  p.tq-desc {
    font-size: 24px;
    line-height: 36px;
    font-weight: 500;
    margin-bottom: 50px;
  }
  .tq-img-box {
    margin-top: 50px;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
  }
  .tq-item img {
    max-height: 72px;
    width: auto;
  }
  .tq-item {
    display: flex;
    justify-content: center;
    padding: 35px 0;
    background-color: #fff;
    border-radius: 16px;
    cursor: pointer;
  }
  .tq-item:hover {
    box-shadow: 0 12px 20px 6px rgba(96, 109, 128, 0.04), 0 8px 16px 4px rgba(96, 109, 128, 0.04),
      0 4px 14px 0 rgba(98, 111, 131, 0.04);
  }
  .tq-item:last-child:nth-child(5n + 1) {
    grid-column: 3; /* 最后放在第3列(居中) */
  }
  @media screen and (max-width: 750px) {
  }
</style>
<div class="trust-quality">
  <div class="tq-content">
    <p class="tq-title">Quality You Can Trust</p>
    <p class="tq-desc">
      As a trusted OEM manufacturer, QY Crafts adheres to the highest international standards in craft production. Our
      facility undergoes rigorous audits and is certified by leading organizations.
    </p>
    <div class="tq-img-box">
      <div class="tq-item">
        <img src="https://cdn.shopify.com/s/files/1/0710/6176/6321/files/tq-1.png?v=1750215387" alt="">
      </div>
      <div class="tq-item">
        <img src="https://cdn.shopify.com/s/files/1/0710/6176/6321/files/tq-1.png?v=1750215387" alt="">
      </div>
      <div class="tq-item">
        <img src="https://cdn.shopify.com/s/files/1/0710/6176/6321/files/tq-1.png?v=1750215387" alt="">
      </div>
      <div class="tq-item">
        <img src="https://cdn.shopify.com/s/files/1/0710/6176/6321/files/tq-1.png?v=1750215387" alt="">
      </div>
      <div class="tq-item">
        <img src="https://cdn.shopify.com/s/files/1/0710/6176/6321/files/tq-1.png?v=1750215387" alt="">
      </div>
      <div class="tq-item">
        <img src="https://cdn.shopify.com/s/files/1/0710/6176/6321/files/tq-1.png?v=1750215387" alt="">
      </div>
    </div>
  </div>
</div>

