<style>
  .num-video {
    padding: 60px 0;
  }
  .num-video p {
    margin: 0;
  }
  .nv-box {
    width: 100%;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: minmax(0, 490px) 100px minmax(0, 850px);
  }
  .nv-left-box {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .nv-item {
    background-color: #fff;
    padding: 30px;
    border-radius: 16px;
  }
  .nv-item .p1 {
    color: #000;
    font-weight: 800;
    font-size: 40px;
    line-height: 54px;
    margin-bottom: 10px;
  }
  .nv-item .p2 {
    color: #2f2d80;
    font-weight: 500;
    font-size: 18px;
    line-height: 30px;
  }
  .nv-item p span {
    font-size: 28px;
  }
  .nv-item p span sup {
    font-size: 16px;
    vertical-align: super;
  }
  .nv-item.item-hide {
    visibility: hidden;
  }
  .nv-left {
    grid-column: 1;
    width: 100%;
    max-width: 490px;
  }
  .nv-right {
    grid-column: 3;
    width: 100%;
    max-width: 850px;
  }
  .nv-video-box {
    border-radius: 16px;
    margin-bottom: 50px;
  }
  .nv-text-box p {
    font-size: 20px;
    line-height: 36px;
    font-weight: 500;
    margin-bottom: 20px;
  }
  .nv-text-box span {
    color: #ef5b80;
    font-weight: 800;
  }
  .num-video .nv-text-box a {
    font-size: 20px;
    line-height: 36px;
    font-weight: 500;
    color: #ef5b80;
    font-weight: 800;
    --main-color: #ef5b80;
    --hover-color: #ef5b80;
    text-decoration: none;
  }
  .num-video .nv-text-box a::after {
    display: none;
  }
  .num-video .nv-text-box a:hover {
    text-decoration: underline;
    text-decoration-color: #ef5b80;
  }
  .nv-text-box strong {
    font-weight: 800;
  }

  /* 视频部分css */
  /* 隐藏所有视频控件 */
  video::-webkit-media-controls {
    display: none !important;
  }
  video::-webkit-media-controls-enclosure {
    display: none !important;
  }

  /* 自定义视频容器样式 */
  .video-container {
    position: relative;
    background-color: #000;
    cursor: pointer;
    overflow: hidden;
    border-radius: 16px;
  }
  /* 视频元素样式 */
  video {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  @media screen and (max-width: 750px) {
    .num-video {
      padding: 30px 0;
    }
    .nv-box {
      grid-template-columns: 1fr;
      justify-content: center;
    }
    .nv-left {
      grid-column: inherit;
    }
    .nv-right {
      grid-column: inherit;
      margin-top: 40px;
    }
    .nv-item {
      padding: 20px;
    }
    .nv-item .p1 {
      font-size: 28px;
      line-height: 36px;
    }
    .nv-item .p2 {
      font-size: 14px;
      line-height: 24px;
    }
    .nv-text-box p,
    .num-video .nv-text-box a {
      font-size: 14px;
      line-height: 24px;
    }
    .num-video .nv-text-box a {
      text-decoration: underline;
      text-decoration-color: #ef5b80;
    }
    .nv-item.item-hide {
      visibility: inherit;
      display: none;
    }
    .nv-video-box {
      margin-bottom: 30px;
    }
  }
</style>
<div class="num-video">
  <div class="nv-content wrapper">
    <div class="nv-box">
      <div class="nv-left">
        <div class="nv-left-box">
          <div class="nv-item">
            <p class="p1">12+</p>
            <p class="p2">Years</p>
          </div>
          <div class="nv-item item-hide">
            <p class="p1">12+</p>
            <p class="p2">Years</p>
          </div>
          <div class="nv-item">
            <p class="p1">100+</p>
            <p class="p2">Machines</p>
          </div>
          <div class="nv-item">
            <p class="p1">1,200+</p>
            <p class="p2">Global Suppliers</p>
          </div>
          <div class="nv-item">
            <p class="p1">153M+</p>
            <p class="p2">Sets Manufactured Annually</p>
          </div>
          <div class="nv-item">
            <p class="p1">
              86,500 <span>ft<sup>2</sup></span>
            </p>
            <p class="p2">Factory</p>
          </div>
          <div class="nv-item item-hide">
            <p class="p1">12+</p>
            <p class="p2">Years</p>
          </div>
          <div class="nv-item">
            <p class="p1">100%</p>
            <p class="p2">Compliance with US/EU Standards</p>
          </div>
        </div>
      </div>
      <div class="nv-right">
        <div class="nv-video-box">
          <div class="video-container">
            <!-- 视频元素 -->
            <video
              id="myVideo"
              preload="auto"
              autoplay
              muted
              playsinline
              webkit-playsinline
              x-webkit-airplay="allow"
              x5-video-player-type="h5"
              x5-video-player-fullscreen="true"
              x5-video-orientation="portraint"
              poster="https://cdn.shopify.com/s/files/1/0710/6176/6321/files/nv-video-img.png"
            >
              <source src="https://cdn.shopify.com/videos/c/o/v/c2e4e9c784394aad995ceec3acbc9d05.mp4" type="video/mp4">
              您的浏览器不支持HTML5视频
            </video>
          </div>
        </div>
        <div class="nv-text-box">
          <p class="nv-text">
            QY Crafts is a <span>leading manufacturer of premium craft materials and creative play components</span>,
            specializing in pom poms, chenille stems, and DIY craft essentials. We transform raw creativity into
            tangible products that inspire makers worldwide.
          </p>
          <p class="nv-text">
            As the manufacturing arm of
            <a href="https://www.paramontgroup.com/"
              ><span><strong>PARAMONT</strong> Group</span></a
            >, we combine global design intelligence with industrial excellence. Our Ningbo and U.S. design teams
            deliver trend-forward concepts, while QY Crafts—with 100+ production lines—ensures precision at scale,
            maintaining a 0.1% defect rate for unmatched quality.
          </p>
          <p class="nv-text">
            We are the <span>Builders of Play</span>: From custom components to complete product lines, we empower
            brands to innovate faster. Leveraging PARAMONT’s 1,200+ supplier network and 50,000+ retail doors, we bridge
            imagination and execution—turning creative visions into market-ready realities with unmatched speed and
            quality.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

