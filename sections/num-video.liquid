<style>
  .num-video {
    padding: 60px 0;
  }
  .num-video p {
    margin: 0;
  }
  .nv-box {
    width: 100%;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: minmax(0, 490px) 100px minmax(0, 850px);
  }
  .nv-left-box {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .nv-item {
    background-color: #fff;
    padding: 30px;
    border-radius: 16px;
  }
  .nv-item .p1 {
    color: #000;
    font-weight: 800;
    font-size: 40px;
    line-height: 54px;
    margin-bottom: 10px;
  }
  .nv-item .p2 {
    color: #2f2d80;
    font-weight: 500;
    font-size: 18px;
    line-height: 30px;
  }
  .nv-item p span {
    font-size: 28px;
  }
  .nv-item p span sup {
    font-size: 16px;
    vertical-align: super;
  }
  .nv-item.item-hide {
    visibility: hidden;
  }
  .nv-left {
    grid-column: 1;
    width: 100%;
    max-width: 490px;
  }
  .nv-right {
    grid-column: 3;
    width: 100%;
    max-width: 850px;
  }
  .nv-video-box {
    border-radius: 16px;
    margin-bottom: 50px;
  }
  .nv-text-box p {
    font-size: 20px;
    line-height: 36px;
    font-weight: 500;
    margin-bottom: 20px;
  }
  .nv-text-box span {
    color: #ef5b80;
    font-weight: 800;
  }
  .nv-text-box strong {
    font-weight: 800;
  }

  /* 视频部分css */
  /* 隐藏所有视频控件 */
  video::-webkit-media-controls {
    display: none !important;
  }
  video::-webkit-media-controls-enclosure {
    display: none !important;
  }

  /* 自定义视频容器样式 */
  .video-container {
    position: relative;
    background-color: #000;
    cursor: pointer;
    overflow: hidden;
    border-radius: 16px;
  }
  /* 封面图样式 */
  .video-cover {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    z-index: 2;
    transition: opacity 0.3s;
  }
  /* 自定义播放按钮样式 */
  .play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100px;
    height: 100px;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
    font-size: 30px;
    z-index: 3;
  }

  .play-button::after {
    content: url('https://cdn.shopify.com/s/files/1/0710/6176/6321/files/class_ic_activate_95bb7f28-a202-443a-94dd-304aaef582d9.png?v=1750489424');
  }

  /* 当视频播放时隐藏封面和播放按钮 */
  video.playing ~ .video-cover,
  video.playing ~ .play-button {
    opacity: 0;
    pointer-events: none;
  }
  /* 视频元素样式 */
  video {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: contain;
    z-index: 1;
  }
  @media screen and (max-width: 750px) {
    .num-video {
      padding: 30px 0;
    }
    .nv-box {
      grid-template-columns: 1fr;
      justify-content: center;
    }
    .nv-left {
      grid-column: inherit;
    }
    .nv-right {
      grid-column: inherit;
      margin-top: 40px;
    }
    .nv-item {
      padding: 20px;
    }
    .nv-item .p1 {
      font-size: 28px;
      line-height: 36px;
    }
    .nv-item .p2 {
      font-size: 14px;
      line-height: 24px;
    }
    .nv-text-box p {
      font-size: 14px;
      line-height: 24px;
    }
    .nv-item.item-hide {
      visibility: inherit;
      display: none;
    }
    .nv-video-box {
      margin-bottom: 30px;
    }
  }
</style>
<div class="num-video">
  <div class="nv-content wrapper">
    <div class="nv-box">
      <div class="nv-left">
        <div class="nv-left-box">
          <div class="nv-item">
            <p class="p1">12+</p>
            <p class="p2">Years</p>
          </div>
          <div class="nv-item item-hide">
            <p class="p1">12+</p>
            <p class="p2">Years</p>
          </div>
          <div class="nv-item">
            <p class="p1">100+</p>
            <p class="p2">Machines</p>
          </div>
          <div class="nv-item">
            <p class="p1">1,200+</p>
            <p class="p2">Global Suppliers</p>
          </div>
          <div class="nv-item">
            <p class="p1">153M+</p>
            <p class="p2">Sets Manufactured Annually</p>
          </div>
          <div class="nv-item">
            <p class="p1">
              86,500 <span>ft<sup>2</sup></span>
            </p>
            <p class="p2">Factory</p>
          </div>
          <div class="nv-item item-hide">
            <p class="p1">12+</p>
            <p class="p2">Years</p>
          </div>
          <div class="nv-item">
            <p class="p1">100%</p>
            <p class="p2">Compliance with US/EU Standards</p>
          </div>
        </div>
      </div>
      <div class="nv-right">
        <div class="nv-video-box">
          <div class="video-container">
            <!-- 视频元素 -->
            <video
              id="myVideo"
              preload="auto"
              muted
              playsinline
              webkit-playsinline
              x-webkit-airplay="allow"
              x5-video-player-type="h5"
              x5-video-player-fullscreen="true"
              x5-video-orientation="portraint"
            >
              <source src="https://cdn.shopify.com/videos/c/o/v/c2e4e9c784394aad995ceec3acbc9d05.mp4" type="video/mp4">
              您的浏览器不支持HTML5视频
            </video>

            <!-- 自定义封面图 -->
            <div
              class="video-cover"
              id="videoCover"
              style="background-image: url('https://cdn.shopify.com/s/files/1/0710/6176/6321/files/nv-video-img.png?v=1750252409');"
            ></div>

            <!-- 自定义播放按钮 -->
            <div class="play-button" id="playButton"></div>
          </div>
        </div>
        <div class="nv-text-box">
          <p class="nv-text">
            QY Crafts is a <span>leading manufacturer of premium craft materials and creative play components</span>,
            specializing in pom poms, chenille stems, and DIY craft essentials. We transform raw creativity into
            tangible products that inspire makers worldwide.
          </p>
          <p class="nv-text">
            As the manufacturing arm of <span><strong>PARAMONT</strong> Group</span>, we combine global design
            intelligence with industrial excellence. Our Ningbo and U.S. design teams deliver trend-forward concepts,
            while QY Crafts—with 100+ production lines—ensures precision at scale, maintaining a 0.1% defect rate for
            unmatched quality.
          </p>
          <p class="nv-text">
            We are the <span>Builders of Play</span>: From custom components to complete product lines, we empower
            brands to innovate faster. Leveraging PARAMONT’s 1,200+ supplier network and 50,000+ retail doors, we bridge
            imagination and execution—turning creative visions into market-ready realities with unmatched speed and
            quality.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const video = document.getElementById('myVideo');
    const playButton = document.getElementById('playButton');
    const videoCover = document.getElementById('videoCover');

    // 点击视频容器时切换播放/暂停
    document.querySelector('.video-container').addEventListener('click', function () {
      if (video.paused) {
        video.play();
        video.muted = false; // 播放时不静音
        video.classList.add('playing');
      } else {
        video.pause();
        video.classList.remove('playing');
      }
    });

    // 视频结束时显示封面和播放按钮
    video.addEventListener('ended', function () {
      video.classList.remove('playing');
    });

    // 防止视频预加载时自动播放
    video.autoplay = false;

    // 视频开始播放后完全隐藏封面（而不只是透明）
    video.addEventListener('play', function () {
      videoCover.style.display = 'none';
    });

    video.addEventListener('pause', function () {
      if (!video.classList.contains('playing')) {
        videoCover.style.display = 'block';
      }
    });
  });
</script>

