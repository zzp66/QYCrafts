<style>
  .ready-to-sell {
    padding: 60px 0;
  }
  .ready-to-sell p {
    margin: 0;
  }
  .rts-content {
    max-width: 1128px;
    margin: 0 auto;
  }
  p.rts-title {
    font-size: 44px;
    line-height: 54px;
    font-weight: 800;
    text-align: center;
    margin-bottom: 30px;
  }
  p.rts-desc {
    font-size: 20px;
    line-height: 36px;
    font-weight: 500;
    text-align: center;
  }
  .rts-collection-box {
    margin-top: 80px;
  }
  .rts-collection-content {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 60px;
  }
  .collection-text {
    margin-top: 10px;
  }
  .collection-text p {
    text-align: center;
  }
  p.collection-title {
    font-size: 20px;
    line-height: 24px;
    font-weight: 800;
    margin-bottom: 10px;
  }
  p.collection-title sup {
    font-size: 0.6em; /* TM的大小 */
    vertical-align: super;
  }
  p.collection-desc {
    color: #727981;
    font-size: 18px;
    line-height: 22px;
    font-weight: 500;
  }
  .collection-img {
    position: relative;
    display: inline-block;
    overflow: hidden;
    background: #fff;
    border-radius: 16px;
  }
  .collection-img img {
    display: block;
    width: 100%;
    height: auto;
    transition: filter 0.3s ease;
  }
  .rts-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(255, 255, 255, 0.3); /* 半透明白色背景 */
    backdrop-filter: blur(2px); /* 玻璃模糊效果 */
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .rts-overlay img {
    width: 80px;
    height: 80px;
  }

  /* Hover效果 */
  .collection-img:hover .rts-item-img {
    filter: blur(1px); /* 图片本身也轻微模糊 */
  }
  .collection-img:hover .rts-overlay {
    opacity: 1;
  }
  @media screen and (max-width: 750px) {
    .ready-to-sell {
      padding: 30px 0;
    }
    p.rts-title {
      font-size: 24px;
      line-height: 36px;
      margin-bottom: 20px;
    }
    p.rts-desc {
      font-size: 14px;
      line-height: 24px;
    }
    .rts-collection-box {
      margin-top: 40px;
    }
    .rts-collection-content {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    p.collection-desc {
      font-size: 14px;
      line-height: 24px;
    }
  }
</style>
<div class="ready-to-sell">
  <div class="rts-content wrapper">
    <div class="rts-box">
      <p class="rts-title">Ready-to-Sell Craft Collections</p>
      <p class="rts-desc">
        We specialize in OEM/ODM manufacturing across diverse craft categories, supporting the growth of dozens of
        global brands with reliable production and in-house design.
      </p>
      <div class="rts-collection-box">
        <div class="rts-collection-content">
          <div class="rts-item">
            <a href="https://www.qycrafts.com/collections/cozy-craftworks" class="rts-item-url">
              <div class="collection-img">
                <img
                  class="rts-item-img"
                  src="https://cdn.shopify.com/s/files/1/0710/6176/6321/files/34.jpg?v=1751879696"
                  alt=""
                >
                <div class="rts-overlay">
                  <img src="https://cdn.shopify.com/s/files/1/0710/6176/6321/files/arrow.png?v=1750410926" alt="">
                </div>
              </div>
              <div class="collection-text">
                <p class="collection-title">Tooblerz<sup>TM</sup></p>
                <p class="collection-desc">Fuzzy Construction Play Sets</p>
              </div>
            </a>
          </div>
          <div class="rts-item">
            <a href="https://www.qycrafts.com/collections/craft-spot" class="rts-item-url">
              <div class="collection-img">
                <img
                  class="rts-item-img"
                  src="https://cdn.shopify.com/s/files/1/0710/6176/6321/files/43.jpg?v=1751878473"
                  alt=""
                >
                <div class="rts-overlay">
                  <img src="https://cdn.shopify.com/s/files/1/0710/6176/6321/files/arrow.png?v=1750410926" alt="">
                </div>
              </div>
              <div class="collection-text">
                <p class="collection-title">Craft Spot<sup>TM</sup></p>
                <p class="collection-desc">Family-bonding crafts creating shareable memories</p>
              </div>
            </a>
          </div>
          <div class="rts-item">
            <a href="https://www.qycrafts.com/collections/cozy-craftworks" class="rts-item-url">
              <div class="collection-img">
                <img
                  class="rts-item-img"
                  src="https://cdn.shopify.com/s/files/1/0710/6176/6321/files/33.jpg?v=1751964567"
                  alt=""
                >
                <div class="rts-overlay">
                  <img src="https://cdn.shopify.com/s/files/1/0710/6176/6321/files/arrow.png?v=1750410926" alt="">
                </div>
              </div>
              <div class="collection-text">
                <p class="collection-title">Cozy Craftworks<sup>TM</sup></p>
                <p class="collection-desc">Stress-relieving soft crafts for mindful creativity</p>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

