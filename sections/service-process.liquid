<style>
  .service-process {
    padding: 60px 0;
  }
  .service-process p {
    margin: 0;
  }
  .service-process img {
    max-width: 100%;
    height: auto;
  }
  .sp-content {
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 70px;
    padding: 10px 10px 10px 60px;
    background-color: #f8cc56;
    border-radius: 16px;
  }
  p.sp-info-title {
    font-size: 44px;
    line-height: 56px;
    font-weight: 800;
    max-width: 528px;
    margin-bottom: 30px;
  }
  .sp-info-desc p {
    font-size: 20px;
    line-height: 36px;
    font-weight: 500;
  }
  p.desc-1 {
    margin-bottom: 25px;
  }
  p.desc-2 {
    margin-bottom: 50px;
  }
  a.sp-btn {
    display: inline-block;
    padding: 16px 40px;
    font-size: 20px;
    line-height: 24px;
    font-weight: 800;
    color: #fff;
    background-color: #2f2d80;
    border-radius: 16px;
  }
  a.sp-btn:hover {
    background-color: #fff;
    color: #2f2d80;
  }
  .sp-img {
    min-width: 580px;
  }
  .sp-img img {
    width: 100%;
    height: 724px;
    object-fit: cover;
    border-radius: 16px;
  }
  @media screen and (max-width: 750px) {
    .service-process {
      padding: 30px 0;
    }
    .sp-content {
      flex-direction: column-reverse;
      padding: 10px;
      gap: 30px;
    }
    p.sp-info-title {
      font-size: 24px;
      line-height: 36px;
      margin-bottom: 20px;
    }
    .sp-img {
      min-width: inherit;
    }
    .sp-img img {
      width: 100%;
      height: auto;
    }
    .sp-info-desc p {
      font-size: 14px;
      line-height: 24px;
    }
    p.desc-1 {
      margin-bottom: 15px;
    }
    p.desc-2 {
      margin-bottom: 20px;
    }
    a.sp-btn {
      display: flex;
      justify-content: center;
      font-size: 14px;
      line-height: 24px;
    }
  }
</style>
<div class="service-process">
  <div class="wrapper">
    <div class="sp-content">
      <div class="sp-info-box">
        <p class="sp-info-title">All-in-One OEM/ODM Craft Solutions</p>
        <div class="sp-info-desc">
          <p class="desc-1">
            QY Crafts delivers complete OEM/ODM solutions from concept to delivery. Our streamlined 3-phase process -
            prototyping, pre-production, and mass production - features four quality checkpoints to ensure perfect
            execution. With 120+ customizable SKUs and top-tier-licensor-compliant standards, we handle everything from
            3D modeling to packaging while optimizing costs.
          </p>
          <p class="desc-2">
            For brands seeking ready-to-market solutions, we offer design-to-production services that deliver
            retail-ready collectibles 30% faster than industry standards. Whether developing new products or customizing
            existing designs, we combine creative expertise with industrial efficiency to bring your vision to market
            without compromise.
          </p>
        </div>
        <a href="#" class="sp-btn">Contact Us</a>
      </div>
      <div class="sp-img">
        <img src="https://cdn.shopify.com/s/files/1/0710/6176/6321/files/sp-1.jpg?v=1750229882" alt="">
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Service Process",
  "settings": [],
  "presets": [
    {
      "name": "Service Process"
    }
  ]
}
{% endschema %}
