<style>
  .trust-quality {
    padding: 60px 0;
  }
  .trust-quality p {
    margin: 0;
  }
  .trust-quality img {
    max-width: 100%;
    height: auto;
  }
  .tq-content {
    margin: 0 auto;
  }
  p.tq-title {
    font-size: 44px;
    line-height: 60px;
    font-weight: 800;
    margin-bottom: 30px;
  }
  p.tq-desc {
    max-width: 1330px;
    font-size: 20px;
    line-height: 36px;
    font-weight: 500;
    margin-bottom: 50px;
  }
  .tq-img-box {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    justify-content: center;
    gap: 20px;
  }
  .tq-img-box::after {
    content: '';
    grid-column: 1 / -1; /* 占据整行 */
    height: 0;
  }
  .tq-item img {
    max-height: 72px;
    width: auto;
  }

  .tq-item {
    display: flex;
    justify-content: center;
    padding: 24px 0;
    background-color: #fff;
    border-radius: 16px;
    cursor: pointer;
  }
  .tq-item:hover {
    box-shadow: 0 12px 20px 6px rgba(96, 109, 128, 0.04), 0 8px 16px 4px rgba(96, 109, 128, 0.04),
      0 4px 14px 0 rgba(98, 111, 131, 0.04);
  }

  @media screen and (max-width: 750px) {
    .trust-quality {
      padding: 30px 0;
    }
    p.tq-title {
      font-size: 24px;
      line-height: 36px;
      margin-bottom: 20px;
    }
    p.tq-desc {
      font-size: 14px;
      line-height: 24px;
      margin-bottom: 30px;
    }
    .tq-img-box {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
  }
</style>
